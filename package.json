{
  "name": "crumza",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm --filter @crumza/ui build && pnpm --filter @crumza/docs build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @crumza/docs e2e",
    "validate": "pnpm check && pnpm build && pnpm typecheck && pnpm test && pnpm e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
