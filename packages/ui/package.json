{
  "name": "@crumza/ui",
  "version": "0.1.0-beta.0",
  "description": "A UI framework that turns a brand into a complete, accessible interface: set a colour, get every colour, live. Borderless, shadowless, real-spring motion. CSS first, any framework or none.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./crumza.css": "./dist/crumza.css",
    "./crumza.min.css": "./dist/crumza.min.css",
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "default": "./dist/brand/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "default": "./dist/motion/index.js"
    },
    "./behaviors": {
      "types": "./dist/behaviors/index.d.ts",
      "default": "./dist/behaviors/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cereble/crumza.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "css",
    "design-system",
    "ui",
    "brand",
    "theme",
    "color",
    "oklch",
    "contrast",
    "wcag",
    "spring",
    "motion",
    "accessibility"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "homepage": "https://github.com/cereble/crumza#readme",
  "bugs": "https://github.com/cereble/crumza/issues"
}
